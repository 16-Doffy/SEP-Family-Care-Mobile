<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Wear OS companion feature declaration -->
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />

    <!-- GPS permissions for SOS location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: quét QR lời mời (mobile_scanner) + hình trong gọi video -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Gọi video qua LiveKit: micro + định tuyến âm thanh loa/tai nghe.
         BLUETOOTH_CONNECT chỉ cần từ Android 12 (API 31) để dùng tai nghe
         bluetooth trong cuộc gọi; máy cũ hơn bỏ qua, không ảnh hưởng. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Foreground service cho SOS nền và giữ cuộc gọi video khi khoá màn hình/xuống nền -->
    <!-- Giữ CPU thức trong lúc SosGuardService canh cảm biến. Thiếu quyền này
         thì màn hình tắt là SoC ngủ, gia tốc kế ngừng gửi dữ liệu và cú té ngã
         đi qua mà không phát hiện được. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- SosEmergencyFlowService lấy GPS trong lúc chạy foreground service —
         bắt buộc từ Android 14 (API 34) cho foregroundServiceType="location". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Rung mạnh khi phát hiện lắc/té ngã — chống báo động giả (SosGuardService) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Thông báo hệ thống (Android 13+ bắt buộc xin runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Family Care"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Bật deep linking cho go_router (bắt URI rồi map vào route) -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lối tắt SOS: giữ icon app → "Gửi SOS khẩn cấp"; kéo ra màn
                 hình chính thành nút 1 chạm. Bắt buộc khai trên chính activity
                 có MAIN/LAUNCHER ở trên. Xem res/xml/shortcuts.xml. -->
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts" />
            <!-- Deep link lời mời: familycare://app/join?token=... — mở thẳng
                 màn Tham gia gia đình, không cần BE host trang web /join -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="familycare" android:host="app" />
            </intent-filter>
        </activity>
        <service
            android:name=".SosGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Theo dõi cảm biến để kích hoạt SOS khi lắc mạnh hoặc té ngã" />
        </service>
        <service
            android:name=".CallGuardService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
        <!-- Đếm ngược -> lấy GPS -> gửi SOS khi phát hiện té ngã, chạy độc lập
             Activity/Flutter engine. Xem SosEmergencyFlowService. -->
        <service
            android:name=".SosEmergencyFlowService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Nhận action "Tôi ổn" / "Gửi SOS ngay" từ notification đếm ngược té
             ngã — không mở MainActivity. -->
        <receiver
            android:name=".SosFallActionReceiver"
            android:exported="false" />
        <!-- Cầu nối Garmin Connect IQ SDK <-> backend — nhận FALL_DETECTED từ
             watch app độc lập Activity/Flutter engine. Xem
             GarminBridgeService.
             Dùng "specialUse" (không phải "connectedDevice"): loại đó đòi
             thêm 1 quyền Bluetooth phải CẤP RUNTIME mới qua được
             startForeground, gây crash app cho MỌI user chưa từng cấp
             Bluetooth (phát hiện qua test thật 2026-08-18). -->
        <service
            android:name=".GarminBridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giữ kết nối với đồng hồ Garmin để nhận cảnh báo té ngã" />
        </service>
        <!-- Bám theo màn Emergency SOS của hệ thống (chỉ ColorOS — xem
             EmergencySosMatcher). AccessibilityService, không phải foreground
             service — người dùng tự bật thủ công trong Cài đặt > Trợ năng,
             app không tự bật được. -->
        <service
            android:name=".EmergencySosWatcherService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/emergency_sos_watcher_config" />
        </service>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- url_launcher: open Google Maps / geo links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- tel: links for emergency numbers -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- text processing -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
